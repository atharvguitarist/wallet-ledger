# Copy to .env (same folder as docker-compose.yml) to override defaults.
ADMIN_TOKEN=dev-admin-token
WITHDRAWAL_FEE_PAISE=200

# LLM: mock works offline. To use a real model set ONE of these:
LLM_PROVIDER=mock
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   (any OpenAI-compatible endpoint, e.g. Groq or Gemini)
# LLM_MODEL=

# Nightly job schedule (Asia/Kolkata). Default 02:30 every night.
RECON_CRON=30 2 * * *
RUN_JOBS_ON_START=true
